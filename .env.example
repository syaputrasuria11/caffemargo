# Contoh environment (JANGAN isi rahasia di sini; salin ke .env yang di-gitignore)
# Backend / database (jalankan MySQL/MariaDB XAMPP; backend PHP/Node/...)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=caffemargo
DB_USER=root
DB_PASS=

# API yang dipakai frontend (kalau backend dipisah/origin beda)
API_BASE_URL=http://localhost

# Admin (jangan simpan password asli; password di DB sebagai hash; auth server-side)
# ADMIN_PASSWORD_HASH=   # disimpan di DB admins.password_hash, bukan di env frontend

# Payment provider QRIS (kalau integrasi sungguhan) — SERVER SIDE saja
# QRIS_PROVIDER_KEY=
